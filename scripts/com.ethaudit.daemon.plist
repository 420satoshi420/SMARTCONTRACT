<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ethaudit.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd . && python3 scripts/batch_scanner.py >> logs/batch_run.log 2>&1</string>
    </array>
    <key>StartInterval</key>
    <integer>21600</integer> <!-- Runs every 6 hours -->
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>./logs/daemon_err.log</string>
    <key>StandardOutPath</key>
    <string>./logs/daemon_out.log</string>
</dict>
</plist>
