# ==============================================================================
# ETH-HUNTER & ONE-BRAIN CONFIGURATION TEMPLATE
# Copy to .env and fill in your keys
# ==============================================================================

# Primary LLM API Keys (task router will automatically use the best available)
# Recommended for Red Team / Exploit Synthesis: Anthropic Claude 3.5 Sonnet
ANTHROPIC_API_KEY=

# Recommended for Blue Team Defense / Fast Screening / Synthesis: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# OpenAI API Key (Alternative for Blue Team & Triage)
OPENAI_API_KEY=

# NVIDIA NIM API Key (Nemotron 16k Extended Reasoning)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Web3 On-Chain Verification & Source Fetching
# Get a free 5 req/sec key at https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Ethereum Mainnet RPC URL (for Foundry Fork-Testing: forge test --fork-url)
# Get a free endpoint at https://alchemy.com or https://infura.io
ETH_RPC_URL=

# Real-Time Price & Token Valuation (CoinMarketCap API)
# Get a free 10k-15k reqs/mo key at https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=
CMC_PRO_API_KEY=

# Real-Time Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Directory Overrides (Optional)
CACHE_DIR=../cache
