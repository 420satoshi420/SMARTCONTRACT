# ==============================================================================
# Enterprise Git Ignore Configuration
# Strict policy: ONLY production code is tracked. Dev tools, brain sweeps,
# scratch scripts, logs, and sensitive assets are strictly excluded.
# ==============================================================================

# Environment & Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Dependencies & Build Artifacts
node_modules/
dist/
venv/
.venv/
__pycache__/
*.pyc
out/
cache/
.foundry/
broadcast/

# Local Logs & OS Files
*.log
logs/
.DS_Store
.vscode/
.idea/

# Internal Research, Brain Sweeps & Dumps
results/
eth-hunter-brain/
slither_output.json
*.diff
*.patch
*.zip
*.tar
*.tgz
*.dmg
*.vsix
*.csv
*.pdf
scripts/bin/

# Local Dev & Testing Scratch Scripts
autonomous_loop.py
continuous_loop_worker.py
eth_audit_agent
start_*.sh
start_*.bat
run_audit.sh
setup_linux.sh
scripts/build_brain.py
scripts/batch_scanner.py
scripts/browser_task.py
scripts/generate_wallet.py
scripts/pearlai_client.py
