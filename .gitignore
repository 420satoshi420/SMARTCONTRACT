.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Dependencies & Build Artifacts
node_modules/
dist/
venv/
.venv/
__pycache__/
*.pyc
out/
cache/
.foundry/
broadcast/

# Local Logs & OS Metadata
*.log
logs/
.DS_Store
.vscode/
.idea/

# Internal Research, Raw Sweeps & Brain Logs
results/
eth-hunter-brain/
slither_output.json
*.diff
*.patch
*.zip
*.tar
*.tgz
*.dmg
*.vsix
*.csv
*.pdf
scripts/bin/

